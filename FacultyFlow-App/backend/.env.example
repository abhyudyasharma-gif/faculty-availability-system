# FacultyFlow API — copy this file to .env and fill in your MySQL password.
#   PowerShell:  Copy-Item .env.example .env ; notepad .env
# .env is git-ignored — never commit real credentials.

# --- MySQL (same values you use in MySQL Workbench) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=facultyflow_db
# --- API server ---
PORT=5000
# Optional: comma-separated extra browser origins allowed to call the API.
# The local Vite dev server (5173/5174) and the preview server (4173) are
# allowed by default.
# CORS_ORIGINS=http://127.0.0.1:5174
